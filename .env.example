# Read by docker-compose.yml for variable substitution (${DOMAIN}, etc).
# Copy this to .env in the same folder and fill in real values.
# Never commit the real .env — it's your live domain/credentials.

# Your public domain, pointed at this Pi. Caddy uses this both to know
# what to serve and to automatically request a Let's Encrypt certificate
# for it — see DEPLOYMENT.md for the Porkbun DNS + port-forwarding setup
# this depends on.
DOMAIN=vinyl.example.com

# Email Let's Encrypt uses for certificate expiry/problem notices.
# Required, not just a nice-to-have: the Caddyfile's global `email`
# directive errors on startup if this is blank.
ACME_EMAIL=you@example.com

# Only read when you run `docker compose --profile ddns up -d` — skip
# this entirely if your Pi's home IP is already static. One line of
# JSON; see DEPLOYMENT.md for how to get a Porkbun API key/secret and
# the full field reference (github.com/qdm12/ddns-updater/blob/master/docs/porkbun.md).
DDNS_CONFIG={"settings":[{"provider":"porkbun","domain":"vinyl.example.com","api_key":"pk1_your_key","secret_api_key":"sk1_your_secret","ip_version":"ipv4"}]}

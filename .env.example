# Read by docker-compose.yml for variable substitution (${TUNNEL_TOKEN}).
# Copy this to .env in the same folder and fill in the real value.
# Never commit the real .env — it's a live credential for your tunnel.

# Cloudflare Tunnel token for the cloudflared container. This is what
# lets the Pi reach the outside world with no router configuration and
# no inbound port forwarding at all — see DEPLOYMENT.md.
#
# Get it from the Cloudflare Zero Trust dashboard: Networks > Tunnels >
# create a tunnel (choose the "Cloudflared" connector type) > the
# install-connector step shows a command containing
# `--token eyJ...` — that long value after --token is TUNNEL_TOKEN.
# The Public Hostname rule (domain: michabrenner.com, path:
# vinyl-collection, service: http://caddy:80) is configured on the same
# tunnel afterwards, in the dashboard, not here.
TUNNEL_TOKEN=your-tunnel-token-here

# Copy this to backend/.env on the Pi (docker-compose.yml reads it via
# env_file). This is deliberately separate from .env.example, which is
# for local `npm run start:dev` — the values differ in a few places
# that matter (see the comments below).

# Server
PORT=3000
# Your real public domain (the app is served under a /vinyl-collection
# subpath of it — see DEPLOYMENT.md — but CORS checks the origin, not
# the path). With Caddy fronting both the frontend and the API under
# one origin (see frontend/Caddyfile) and Cloudflare Tunnel in front of
# that, the browser never actually makes a cross-origin request — this
# mostly matters as defense-in-depth and for any direct API access.
FRONTEND_ORIGIN=https://michabrenner.com

# Database (Prisma 7 + SQLite). An absolute path here — not the
# relative "file:./prisma/dev.db" used for local dev — sidesteps Prisma
# resolving a relative path against whatever the container's working
# directory happens to be (the open question noted in
# architecture-and-data-model.md's self-hosting section). /data/db is
# the ./data/db bind mount from docker-compose.yml.
DATABASE_URL="file:/data/db/vinyl.db"

# Where uploaded scans are stored inside the container — /data/uploads
# is the ./data/uploads bind mount from docker-compose.yml. Backed by
# the UPLOADS_ROOT override already built into uploads.service.ts.
UPLOADS_ROOT=/data/uploads

# Auth (single admin user) — same idea as local dev. Generate the hash
# with (see DEPLOYMENT.md for the full first-run sequence):
#   docker compose run --rm backend node scripts/hash-password.js "your-password-here"
ADMIN_USERNAME=micha
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Discogs import feature (backend/src/import/) — a personal access token,
# not OAuth: this app only ever acts as its own single admin, never on
# behalf of another Discogs user. Get one at
# https://www.discogs.com/settings/developers ("Generate new token").
# Discogs requires a descriptive User-Agent on every request.
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=VinylArchive/1.0 +https://michabrenner.com/vinyl-collection

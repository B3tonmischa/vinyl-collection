# Caddy is purely an internal service now: it has no host-published port
# and issues no certificates of its own. Public HTTPS is terminated by
# Cloudflare's edge; the cloudflared container (see docker-compose.yml)
# makes an outbound-only connection from this network to Cloudflare and
# forwards matching requests here in plain HTTP. See DEPLOYMENT.md.
#
# Cloudflare Tunnel's path-based routing does NOT strip the matched
# path prefix before forwarding — a request for
# https://michabrenner.com/vinyl-collection/foo arrives here as
# /vinyl-collection/foo, not /foo. So Caddy does the stripping itself,
# via handle_path. The more specific /vinyl-collection/api/* block must
# come first: Caddy uses the first matching handle/handle_path block in
# file order, and the plain /vinyl-collection/* block below would also
# match API requests if it came first.

{
	# cloudflared reaches Caddy from a private container address and sets
	# X-Forwarded-For to the real visitor. Trusting private ranges makes
	# Caddy pass that on to the backend instead of replacing it with
	# cloudflared's own address — the backend's login rate limit is per
	# client IP (see backend/src/main.ts).
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip zstd

	# Baseline hardening for every response, API and static files alike.
	# No HSTS: that would bind the whole domain, which this app only owns
	# a subpath of.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# The admin's camera capture is the only powerful feature in use.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	# Content-Security-Policy. Everything the app loads is same-origin
	# (bundles, styles, the API, uploaded images, the workers and the
	# self-hosted OpenCV build), so the policy starts from default-src
	# 'self'. The allowances beyond that:
	#  - style-src 'unsafe-inline': Angular inserts each component's styles
	#    as <style> elements at runtime, and [style.x] bindings set inline
	#    styles. Hashing or nonces would need per-request nonce generation,
	#    which a static file server doesn't do. Inline *scripts* stay
	#    blocked. That is also why angular.json turns off inlineCritical:
	#    the critical-CSS inliner adds an inline <script> to index.html.
	#  - script-src 'wasm-unsafe-eval': lets the scan worker compile
	#    OpenCV's WebAssembly. It allows wasm compilation only, not eval().
	#  - img-src https://*.discogs.com: the Discogs import dialog shows
	#    search-result thumbnails straight from Discogs' image CDN
	#    (i.discogs.com today, img.discogs.com in older data).
	#  - object-src/base-uri/form-action/frame-ancestors: not covered by
	#    default-src, so they are locked down explicitly.
	#
	# A worker takes its CSP from its own script response, not from the
	# page that starts it. The scan worker (/workers/scan-worker.js), and
	# with it the opencv.js it importScripts, therefore get a second
	# policy, the page policy plus:
	#  - script-src 'unsafe-eval': OpenCV.js's embind bindings build
	#    functions with `new Function` while they initialise
	#    (createNamedFunction, makeDynCaller). Without this, the worker's
	#    init fails with an EvalError, so the camera's auto-crop is gone.
	#  - connect-src data:: opencv.js carries its wasm as a data: URI and
	#    fetch()es it. When that fetch is blocked, Emscripten falls back to
	#    decoding it synchronously, so this only avoids a logged violation
	#    and the slower path. A data: fetch never leaves the browser.
	# 'unsafe-eval' stays out of the page policy itself. The other worker,
	# Angular's disc-detect module worker (worker-<hash>.js at the app
	# root), needs nothing beyond the page policy.
	@scanWorker path /vinyl-collection/workers/*
	@notScanWorker not path /vinyl-collection/workers/*
	header @notScanWorker Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.discogs.com; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	header @scanWorker Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https://*.discogs.com; font-src 'self'; connect-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# Bare /vinyl-collection (no trailing slash) would otherwise fall
	# through to the SPA handler below with a path that doesn't match
	# any static file, and try_files would silently serve index.html
	# at the wrong base — redirect to the canonical trailing-slash form.
	redir /vinyl-collection /vinyl-collection/ 308

	handle_path /vinyl-collection/api/* {
		reverse_proxy backend:3000
	}

	handle_path /vinyl-collection/* {
		root * /srv

		# Files whose URL changes whenever their content does can be kept
		# by the browser for good, instead of being asked about on every
		# page load:
		#  - Angular's bundles, which carry a content hash in their name
		#    (main-IVAMGJCS.js, chunk-BhlHx9_h.js, styles-74ZVEH7O.css);
		#  - the scan worker and the 10 MB OpenCV build it loads, which
		#    are requested with a ?v= version (see scan-detector.ts and
		#    scan-worker.js).
		# index.html matches neither and is still revalidated every time,
		# which is how a new deploy reaches the browser at all.
		@hashed path_regexp -[A-Za-z0-9_-]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@versioned path /workers/* /vendor/*
		header @versioned Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
